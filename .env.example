# Copy to .env and fill in locally. Never paste these into chat, source, logs or command lines.
# Only these keys are used. CLO_SEARCH_API_KEY is reserved, and the two *_TEST_* keys are read only by the paid probes.
# clo start passes the QQ credentials and the chat key of the provider in use to the Gateway or the bot by environment
# and never prints them. It never passes CLO_TEST_API_KEY or CLO_TEST_ANTHROPIC_API_KEY.

# QQ bot credentials from q.qq.com. CLO_QQ_APP_ID must equal qq.appId in config.json.
CLO_QQ_APP_ID=
CLO_QQ_APP_SECRET=

# Chat key, for this project only. This currently works only with OpenRouter: other OpenAI-compatible endpoints are not
# supported yet. Needs a daily limit on the OpenRouter side. Not needed for dry-run.
# A line named OPENROUTER_API_KEY in this file is not read. clo start gives the Gateway this value under that name.
CLO_CHAT_API_KEY=

# Reserved for search, which is not in this build. Nothing reads it.
CLO_SEARCH_API_KEY=

# Only for the paid probe (q5-probe on the own runtime). Create it separately in OpenRouter and give it a daily limit
# at or below the probe's cap (--max-usd). The bot never uses it.
CLO_TEST_API_KEY=

# Anthropic chat key: only for the own runtime with the anthropic provider in use (clo provider use). Create it in a
# dedicated, non-default workspace with a small monthly spend limit and prepaid credits with auto-reload off, then
# attest that with clo ack hard-cap. Anthropic has no per-key daily limit. Not needed for dry-run.
# A line named ANTHROPIC_API_KEY in this file is not read, and no child process ever gets that name.
CLO_ANTHROPIC_API_KEY=

# Only for the paid Anthropic probe (q5-anthropic). Create it in a separate probe workspace whose spend limit or prepaid
# balance is at or below the probe's cap. The bot never uses it.
CLO_TEST_ANTHROPIC_API_KEY=
